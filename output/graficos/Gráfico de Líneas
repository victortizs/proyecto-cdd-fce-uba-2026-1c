produccion_gas_y_petroleo <- read.csv("C:/Users/ARIANA/OneDrive/Escritorio/GitHup/proyecto-cdd-fce-uba-2026-1c/input/produccion_gas_y_petro.csv")

#Plot

->Petróleo

petroleo <- produccion_gas_y_petroleo %>%
  filter(cuenca %in% c("NEUQUINA", "GOLFO SAN JORGE")) %>%
  group_by(anio, cuenca) %>%
  summarise(
    produccion = sum(cant_petroleo_m3, na.rm = TRUE),
    .groups = "drop"
  )
  
  ggplot(petroleo,
       aes(x = anio,
           y = produccion,
           color = cuenca,
           group = cuenca)) +
  geom_line(size = 1.2) +
  geom_point(size = 2) +
  labs(
    title = "Producción de petróleo",
    subtitle = "Cuenca Neuquina vs Golfo San Jorge",
    x = "Año",
    y = "Producción (m³)",
    color = "Cuenca"
  ) + 
  scale_y_continuous(
    labels = scales::label_number(
      scale = 1e-6,
      suffix = " Mill."
    )
  ) +
  theme_minimal()
  
  ->Gas
  
